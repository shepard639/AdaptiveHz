*.class

# Generated files
bin/
gen/
out/
build/
**/build/
/build
/captures
.externalNativeBuild
.cxx

# Gradle files
.gradle/
.kotlin/

# Local configuration file (sdk path, etc)
local.properties
/local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ IDEA
*.iml
.idea/
.idea/caches
.idea/libraries

# Keystore files & credentials
*.jks
*.keystore
*.p12
*.idsig
KEYSTORE_CREDENTIALS*
KEYSTORE_PASSWORDS*
output-metadata.json

# Temporary dumps & screenshots
*.dump
window_dump.xml
current_screen*.png
live_*.png
screen*.png
screen_*.png
*.png.bak

# Store assets: keep screenshots & icon, but exclude binaries
store_assets/*.apk
store_assets/*.aab

