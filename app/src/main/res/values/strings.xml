    <!-- Пояснение Shizuku для обычных пользователей -->
    <string name="shizuku_help_pill_btn">Что такое Shizuku и зачем он нужен? 💡</string>
    <string name="shizuku_explainer_title">Зачем нужен системный ключ Shizuku?</string>
    <string name="shizuku_explainer_why_title">Почему приложение не может включить 120 Гц сразу?</string>
    <string name="shizuku_explainer_why_desc">В Android управление частотой обновления экрана защищено системой от обычных приложений. Раньше для разблокировки требовалось подключать смартфон к компьютеру через USB-кабель и вводить команды в черном окне терминала.</string>
    <string name="shizuku_explainer_what_title">Что такое Shizuku?</string>
    <string name="shizuku_explainer_what_desc">Shizuku — это официальный, признанный во всем мире инструмент с открытым исходным кодом (доступен в Google Play). Он подключается к встроенной в телефон функции «Беспроводная отладка» по Wi-Fi и работает как безопасный цифровой ключ прямо внутри устройства.</string>
    <string name="shizuku_explainer_safety_title">Это безопасно?</string>
    <string name="shizuku_explainer_safety_desc">Абсолютно безопасно. Приложение не требует Root-прав, не модифицирует прошивку, не имеет разрешения на доступ в интернет (0 сетевых пакетов) и ничего никуда не передает.</string>
    <string name="shizuku_explainer_steps_title">Как настроить за 1 минуту:</string>
    <string name="shizuku_explainer_step1">1. Установите Shizuku из Google Play.</string>
    <string name="shizuku_explainer_step2">2. В «Параметрах разработчика» включите «Беспроводная отладка» и введите код сопряжения в Shizuku.</string>
    <string name="shizuku_explainer_step3">3. Нажмите в AdaptiveHz кнопку «Выдать через Shizuku».</string>
    <string name="shizuku_explainer_close">Все понятно, спасибо!</string>

    <!-- Кросс-продвижение HealthCraft -->
